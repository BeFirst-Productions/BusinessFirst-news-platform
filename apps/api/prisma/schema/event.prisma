model Event {
  id        String   @id @default(uuid())
  title     String
  badge     String?
  image     String?
  linkUrl   String?
  linkText  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}
