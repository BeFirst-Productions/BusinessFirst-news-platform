model PageSeo {
  id                 String          @id @default(uuid())
  slug               String          @unique
  label              String
  pageType           PageType        @default(CUSTOM)
  categoryId         String?
  metaTitle          String
  metaDescription    String
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?
  ogImage            String?
  twitterCard        TwitterCardType @default(SUMMARY_LARGE_IMAGE)
  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?
  structuredData     Json?
  robots             String?         @default("index, follow")
  extraMeta          Json?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  category           Category?       @relation("CategorySeo", fields: [categoryId], references: [id])

  @@index([slug])
  @@index([pageType])
  @@index([categoryId])
  @@index([isActive])
}
